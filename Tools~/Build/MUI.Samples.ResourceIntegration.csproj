<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Samples~/ResourceIntegration/**/*.cs" />
    <ProjectReference Include="MUI.Core.csproj" />
    <ProjectReference Include="MUI.Resources.csproj" />
    <ProjectReference Include="MUI.UGUI.csproj" />
    <ProjectReference Include="MUI.Localization.csproj" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(UnityManagedPath)/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckUnityReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityManagedPath)/UnityEngine.CoreModule.dll')" Text="Set UnityManagedPath to the Unity Editor Managed/UnityEngine directory." />
  </Target>
</Project>
