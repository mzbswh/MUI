<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Editor/TMP/**/*.cs" />
    <ProjectReference Include="MUI.Core.csproj" />
    <ProjectReference Include="MUI.UGUI.csproj" />
    <ProjectReference Include="MUI.TMP.csproj" />
    <ProjectReference Include="MUI.Editor.csproj" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEditor.CoreModule"><HintPath>$(UnityManagedPath)/UnityEditor.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(UnityUIAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(UnityTMPAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
