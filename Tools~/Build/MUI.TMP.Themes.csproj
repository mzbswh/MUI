<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/Rendering/TMP.Themes/**/*.cs" />
    <ProjectReference Include="MUI.Core.csproj" />
    <ProjectReference Include="MUI.Themes.csproj" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(UnityUIAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(UnityTMPAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckTMPReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityTMPAssemblyPath)')" Text="Set UnityTMPAssemblyPath to Unity.TextMeshPro.dll from a matching Unity project." />
  </Target>
</Project>
