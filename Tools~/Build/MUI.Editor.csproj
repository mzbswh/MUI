<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="MUI.Editor.Localization.csproj" />
    <Compile Include="../../Editor/Integrations/UGUI/**/*.cs" Exclude="../../Editor/Integrations/UGUI/Modules/Tabs/**/*.cs;../../Editor/Integrations/UGUI/Modules/Loading/**/*.cs;../../Editor/Integrations/UGUI/Modules/DragDrop/**/*.cs;../../Editor/Integrations/UGUI/Modules/Dialogs/**/*.cs;../../Editor/Integrations/UGUI/Modules/Notifications/**/*.cs" />
    <ProjectReference Include="MUI.Core.csproj" />
    <ProjectReference Include="MUI.Unity.Pages.csproj" />
    <ProjectReference Include="MUI.Unity.Pages.Editor.csproj" />
    <ProjectReference Include="MUI.Resources.csproj" />
    <ProjectReference Include="MUI.Pages.csproj" />
    <ProjectReference Include="MUI.UGUI.csproj" />
    <ProjectReference Include="MUI.Unity.csproj" />
    <Reference Include="UnityEngine.UIElementsModule"><HintPath>$(UnityManagedPath)/UnityEngine.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEditor.UIElementsModule"><HintPath>$(UnityManagedPath)/UnityEditor.UIElementsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(UnityManagedPath)/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(UnityManagedPath)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(UnityManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(UnityUIAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(UnityManagedPath)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEditor.CoreModule"><HintPath>$(UnityManagedPath)/UnityEditor.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckUnityReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(UnityManagedPath)/UnityEngine.CoreModule.dll')" Text="Set UnityManagedPath to the Unity Editor Managed/UnityEngine directory." />
    <Error Condition="!Exists('$(UnityUIAssemblyPath)')" Text="Set UnityUIAssemblyPath to UnityEngine.UI.dll from a matching Unity project." />
  </Target>
</Project>
