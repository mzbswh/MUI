<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Samples~/Scripts/**/*.cs" />
    <AdditionalFiles Include="../../Samples~/Resources/**/*.prefab" />
    <ProjectReference Include="MUI.Core.csproj" />
    <ProjectReference Include="MUI.Pages.csproj" />
    <ProjectReference Include="MUI.Resources.csproj" />
    <ProjectReference Include="MUI.Widgets.csproj" />
    <ProjectReference Include="MUI.UGUI.csproj" />
    <ProjectReference Include="MUI.Tabs.csproj" />
    <ProjectReference Include="MUI.UGUI.Tabs.csproj" />
    <ProjectReference Include="MUI.Dialogs.csproj" />
    <ProjectReference Include="MUI.UGUI.Dialogs.csproj" />
    <ProjectReference Include="MUI.DragDrop.csproj" />
    <ProjectReference Include="MUI.UGUI.DragDrop.csproj" />
    <ProjectReference Include="MUI.Loading.csproj" />
    <ProjectReference Include="MUI.Notifications.csproj" />
    <ProjectReference Include="MUI.Themes.csproj" />
    <ProjectReference Include="MUI.UGUI.Themes.csproj" />
    <ProjectReference Include="../../Generators~/MUI.Generators/MUI.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(UnityManagedPath)/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(UnityManagedPath)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(UnityManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(UnityUIAssemblyPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
